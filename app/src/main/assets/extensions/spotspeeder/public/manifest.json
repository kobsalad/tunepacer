{
  "manifest_version": 3,
  "name": "SpotSpeeder",
  "version": "0.1.0",
  "description": "A GeckoView WebExtension for TunePacer to adjust Spotify playback rate with BPM-smart features",
  "author": "Jacob Lamp",
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "spotspeeder@tunepacer.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["messaging.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
